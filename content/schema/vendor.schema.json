{
  "$ref": "#/definitions/Vendor",
  "definitions": {
    "Vendor": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string"
        },
        "region": {
          "type": "string",
          "enum": [
            "overseas",
            "domestic",
            "both"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "region"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
